# Copy to .env and change every value before running.
POSTGRES_USER=minicloud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=minicloud

# Shared by auth-service (signs tokens) and file-service (verifies them)
JWT_SECRET=change-me-to-a-long-random-string

MINIO_ROOT_USER=minicloud
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_BUCKET=user-files
